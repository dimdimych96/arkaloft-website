# AmoCRM Configuration (Backend)
AMOCRM_DOMAIN=your_subdomain.amocrm.ru
AMOCRM_ACCESS_TOKEN=your_long_lived_access_token

# API Configuration
VITE_API_BASE_URL=https://your-domain.com/api
